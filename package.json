{
  "name": "fixmate-workspace",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "build": "npm --workspace server run check && npm --workspace client run build",
    "seed": "npm --workspace server run seed",
    "check": "npm --workspace server run check && npm --workspace client run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": { "node": ">=20.11.0", "npm": ">=10.0.0" }
}
