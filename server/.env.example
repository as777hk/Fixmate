NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=fixmate
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Google OAuth (optional social sign-in; keep these server-side)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ImgBB API key (server only)
IMGBB_API_KEY=

# Stripe TEST MODE keys only
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Development demo accounts. In production these must be explicitly supplied.
ADMIN_EMAIL=admin@fixmate.local
ADMIN_PASSWORD=FixMateAdmin123!
TECHNICIAN_ONE_EMAIL=tech1@fixmate.local
TECHNICIAN_ONE_PASSWORD=FixMateTech123!
TECHNICIAN_TWO_EMAIL=tech2@fixmate.local
TECHNICIAN_TWO_PASSWORD=FixMateTech123!
CUSTOMER_EMAIL=customer@fixmate.local
CUSTOMER_PASSWORD=FixMateCustomer123!
