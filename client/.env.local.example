# Browser API base and Better Auth origin. In production use the API deployment below.
NEXT_PUBLIC_API_URL=http://localhost:5000
# Canonical public FixMate website URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Next.js rewrite destination (set this to the API deployment in Vercel).
INTERNAL_API_URL=http://localhost:5000
# Optional server-side API URL (set this to the API deployment in Vercel).
API_URL=http://localhost:5000
# Show Google sign-in only after the server OAuth credentials and callback are configured.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
