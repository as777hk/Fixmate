# Public API base used by browser requests. In production, use https://as-fixmate.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:5000
# Optional canonical site URL for metadata/SSR fallbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Next.js rewrite destination for /api/* (server-only; use the Express API origin).
INTERNAL_API_URL=http://localhost:5000
# Optional server-only API URL for server-side helpers.
API_URL=http://localhost:5000
# Show Google sign-in after backend OAuth credentials are configured.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
